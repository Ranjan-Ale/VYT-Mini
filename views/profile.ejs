<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex justify-end w-full">
            <a href="/logout" class="bg-red-500 rounded-md mb-5 inline-block px-3 py-2">Logout</a>
        </div>
        <h3 class="text-3xl mb-5">Hello, <%= user.name %></h3>

        <h5 class="mb-5">you can create a post</h5>
        <form action="/post" method="post">
            <textarea name="content"  class="resize-none outline-none bg-transparent border-3 border-zinc-800 rounded-md"></textarea>
            <input type="submit" value="Create new post" class="px-3 rounded-md mt-2 w-40 py-2 bg-blue-500 block">
        </form>

        <div class="posts mt-20">
            <h3 class="text-zinc-400">your posts</h3>
            <div class="postcontainer mt-5">

                <% user.posts.forEach(function(post){ %>

                <div class="post mb-4 rounded-md w-1/3 p-5 border-2 border-zinc-800">
                    <h4 class="text-blue-500 mb-2"><%= user.username %></h4>
                    <p class="text-sm tracking-tight"><%= post.content %></p>
                    <small class="inline-block mt-5"><%= post.likes.length %> likes</small>
                    <div class="btns flex justify-between mt-5">
                        <a class="text-blue-500" href="/like/<%= post._id %>"><%= post.likes.indexOf(user._id)===-1?"like": "unlike" %></a>
                        <a class="text-zinc-600" href="/edit/<%= post._id %>">Edit</a>
                    </div>
                </div>

                <% }) %>
                
            </div>
        </div>
        
    </div>
    
</body>
</html>