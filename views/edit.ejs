<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex justify-end w-full">
            <a href="/logout" class="bg-red-500 rounded-md mb-5 inline-block px-3 py-2">Logout</a>
        </div>

        <h5 class="mb-5">you can edit your post </h5>
        <form action="/update/<%= post._id %>" method="post">
            <textarea name="content"  class="resize-none outline-none bg-transparent border-3 border-zinc-800 rounded-md"><%= post.content %></textarea>
            <input type="submit" value="Update post" class="px-3 rounded-md mt-2 w-40 py-2 bg-blue-500 block">
        </form>

        
        
    </div>
    
</body>
</html>